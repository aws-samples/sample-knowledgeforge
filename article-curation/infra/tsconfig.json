{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "outDir": "./cdk.out",
    "rootDir": "..",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@kbanalytics/cdk-constructs": ["./kbanalytics-cdk-module-dev/index"]
    }
  },
  "include": ["bin/**/*", "lib/**/*", "../kbanalytics-cdk-module-dev/constructs/**/*", "../kbanalytics-cdk-module-dev/utils/**/*", "../kbanalytics-cdk-module-dev/index.ts"],
  "exclude": ["node_modules", "cdk.out", "../kbanalytics-cdk-module-dev/node_modules", "../kbanalytics-cdk-module-dev/**/__tests__/**", "../kbanalytics-cdk-module-dev/**/*.test.ts", "../kbanalytics-cdk-module-dev/**/*.spec.ts"]
}
